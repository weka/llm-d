ARG BASE_IMAGE=quay.io/weka.io/llm-d:v0.5.0-latest-bef6991-dc515f3f-P33292

# Stage 1: Build LMCache wheel
FROM ${BASE_IMAGE} AS lmcache-builder

USER root

ENV LIBRARY_PATH="/usr/local/cuda/lib64/stubs:${LIBRARY_PATH:-}"

ARG LMCACHE_REPO=https://github.com/weka/LMCache.git
ARG LMCACHE_REF=7e596b7

RUN git clone ${LMCACHE_REPO} /tmp/lmcache && \
    cd /tmp/lmcache && \
    git checkout ${LMCACHE_REF} && \
    . /opt/vllm/bin/activate && \
    uv build --wheel --no-build-isolation --out-dir /tmp/wheels && \
    rm -rf /tmp/lmcache

# Stage 2: Final image with swapped LMCache
FROM ${BASE_IMAGE}

USER root

COPY --from=lmcache-builder /tmp/wheels/ /tmp/wheels/
RUN . /opt/vllm/bin/activate && \
    uv pip install --force-reinstall --no-deps /tmp/wheels/*.whl && \
    rm -rf /tmp/wheels

USER 2000
