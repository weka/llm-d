# Weka-specific llm-d image: multi-arch (x86_64 + ARM64) + CUDA 13.0 + vllm + lmcache weka fork
#
# Key differences from Dockerfile.cuda:
#   - CUDA 13.0 base (vs 12.9 with UBI9)
#   - Ubuntu 24.04
#   - vllm installed as a static wheel (no source build)
#   - torch 2.9.1+cu130 from PyTorch's cu130 index (CUDA 13.0, sm 7.5+)
#   - lmcache from weka fork, wheel from GitHub releases (arm64) or built from source (x86_64)
#   - cupy-cuda13x replaces cupy-cuda12x (CUDA 13 compatible)
#   - Simplified: no NVSHMEM/NIXL/EFA/DeepEP/DeepGEMM source builds
#
# Build (native, auto-detects arch):
#   docker build -f docker/Dockerfile.weka-cuda13 \
#     -t ghcr.io/llm-d/llm-d-weka-cuda:dev \
#     .
#
# Multi-arch via buildx:
#   docker buildx build -f docker/Dockerfile.weka-cuda13 \
#     --platform linux/amd64,linux/arm64 \
#     -t ghcr.io/llm-d/llm-d-weka-cuda:dev \
#     --push .
#
# With a local lmcache wheel (override GitHub download):
#   docker build -f docker/Dockerfile.weka-cuda13 \
#     --build-arg LMCACHE_WHEEL_SRC=local \
#     -t ghcr.io/llm-d/llm-d-weka-cuda:dev \
#     .

ARG CUDA_VERSION=13.0.0
ARG UBUNTU_VERSION=24.04

FROM nvcr.io/nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION}

ARG CUDA_VERSION
ARG UBUNTU_VERSION
ARG PYTHON_VERSION=3.12
ARG VLLM_VERSION=0.18.0

# Weka LMCache wheel configuration.
# ARM64: pre-built wheel downloaded from GitHub releases.
# x86_64: no pre-built wheel available; built from source automatically.
ARG LMCACHE_WEKA_VERSION=0.3.14+weka.62
ARG LMCACHE_WEKA_TAG=v0.3.14-weka.62
ARG LMCACHE_WEKA_WHEEL=lmcache-0.3.14+weka.62-cp312-cp312-manylinux_2_26_aarch64.manylinux_2_28_aarch64.whl
ARG LMCACHE_WHEEL_URL=https://github.com/weka/LMCache/releases/download/${LMCACHE_WEKA_TAG}/${LMCACHE_WEKA_WHEEL}
ARG LMCACHE_GIT_URL=https://github.com/weka/LMCache.git
ARG LMCACHE_GIT_REF=feat/weka-gds-rdma

# LMCACHE_WHEEL_SRC: 'auto' (default, wheel on arm64, source on x86_64),
#                     'remote' (force download), 'local' (COPY from context),
#                     'source' (force build from git)
ARG LMCACHE_WHEEL_SRC=auto

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    UV_HTTP_TIMEOUT=500 \
    UV_INDEX_STRATEGY=unsafe-best-match \
    UV_LINK_MODE=copy \
    VIRTUAL_ENV=/opt/vllm \
    CUDA_HOME=/usr/local/cuda \
    PYTHON_VERSION=${PYTHON_VERSION}

# LD_LIBRARY_PATH: arch-specific lib dir is added at the end for libcuda.so discovery.
# On aarch64: /usr/lib/aarch64-linux-gnu; on x86_64: /usr/lib/x86_64-linux-gnu.
ENV LD_LIBRARY_PATH="${VIRTUAL_ENV}/lib/python${PYTHON_VERSION}/site-packages/torch/lib:\
/usr/local/nvidia/lib:/usr/local/nvidia/lib64:\
${CUDA_HOME}/lib64:\
/usr/local/lib:/usr/local/lib64:\
${LD_LIBRARY_PATH:-}"

# CUDA 13.0 dropped sm_70 (V100); TORCH_CUDA_ARCH_LIST starts at 7.5.
# 10.3a is required for B300 SXM6 (Blackwell) CUTLASS FP8 kernels.
ENV TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9;9.0;9.0a;10.0;10.3a;12.0+PTX"

# Install system dependencies
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
        software-properties-common \
        git \
        curl \
        python3 \
        python3-dev \
        python3-venv \
        python3-pip \
        libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Install uv and create virtualenv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv ~/.local/bin/uv /usr/local/bin/ && \
    mv ~/.local/bin/uvx /usr/local/bin/ && \
    uv venv /opt/vllm --python ${PYTHON_VERSION}

ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

# Install torch 2.9.1+cu130 first so vllm's torch requirement is met
# from the cu130 index (CUDA 13 native build, both aarch64 and x86_64).
# Notes:
#   - torch==2.9.1+cu130 is available for both aarch64 and x86_64
#   - torchaudio/torchvision: no aarch64/cu130 wheels; install from PyPI (CPU-only
#     binary but compatible — vllm only uses torch's CUDA path, not these)
#   - --no-deps on torchaudio/torchvision avoids re-pulling CPU torch from PyPI
RUN --mount=type=cache,target=/root/.cache/uv \
    . /opt/vllm/bin/activate && \
    uv pip install \
        "torch==2.9.1+cu130" \
        --extra-index-url https://download.pytorch.org/whl/cu130 && \
    uv pip install --no-deps \
        "torchaudio==2.9.1" \
        "torchvision==0.24.1"

# Install build tools and CUDA 12 cudart compat (vllm._C links against libcudart.so.12)
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends cmake ninja-build cuda-cudart-12-9 && \
    rm -rf /var/lib/apt/lists/* && ldconfig

# Build vllm from source — the PyPI wheel lacks sm_103a CUTLASS kernels for B300.
# Source build uses TORCH_CUDA_ARCH_LIST (set above) which includes 10.3a.
# Cache mounts: uv/pip for downloads, /tmp/vllm-build for ccache/cmake artifacts.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/tmp/vllm-build \
    . /opt/vllm/bin/activate && \
    uv pip install setuptools setuptools-scm wheel packaging ninja cmake && \
    CCACHE_DIR=/tmp/vllm-build/ccache \
    MAX_JOBS=$(nproc) \
    uv pip install --no-build-isolation --no-binary vllm \
        "vllm==${VLLM_VERSION}" \
        --extra-index-url https://download.pytorch.org/whl/cu130

# Replace cu13 NVIDIA runtime libs with cu12 equivalents for host driver compat.
# Separate layer so vLLM source build above stays cached when changing lib versions.
RUN --mount=type=cache,target=/root/.cache/uv \
    . /opt/vllm/bin/activate && \
    uv pip install --force-reinstall \
        "nvidia-cublas-cu12" \
        "nvidia-cuda-cupti-cu12" \
        "nvidia-cuda-nvrtc-cu12" \
        "nvidia-cuda-runtime-cu12" \
        "nvidia-cusolver-cu12" \
        "nvidia-cusparse-cu12" \
        "nvidia-nccl-cu12" \
        "nvidia-nvjitlink-cu12"

# Install lmcache weka fork.
# Modes controlled by LMCACHE_WHEEL_SRC:
#   auto   - wheel on arm64 (from GitHub releases), source on x86_64 (default)
#   remote - force download wheel from GitHub releases
#   local  - copy from build context (pass wheel via docker build --build-arg)
#   source - force build from git on any arch
#
# After install, replace cupy-cuda12x with cupy-cuda13x.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=.,target=/ctx,rw=false \
    . /opt/vllm/bin/activate && \
    ARCH=$(uname -m) && \
    MODE="${LMCACHE_WHEEL_SRC}" && \
    if [ "${MODE}" = "auto" ]; then \
        if [ "${ARCH}" = "aarch64" ]; then MODE="remote"; else MODE="source"; fi; \
    fi && \
    if [ "${MODE}" = "local" ]; then \
        WHEEL_PATH="/ctx/${LMCACHE_WEKA_WHEEL}"; \
        echo "Installing lmcache from local wheel: ${WHEEL_PATH}"; \
        uv pip install "${WHEEL_PATH}"; \
    elif [ "${MODE}" = "source" ]; then \
        echo "Building lmcache from source (${ARCH}): ${LMCACHE_GIT_URL}@${LMCACHE_GIT_REF}"; \
        SETUPTOOLS_SCM_PRETEND_VERSION="${LMCACHE_WEKA_VERSION}" \
        uv pip install --no-build-isolation "lmcache @ git+${LMCACHE_GIT_URL}@${LMCACHE_GIT_REF}"; \
    else \
        echo "Installing lmcache from: ${LMCACHE_WHEEL_URL}"; \
        uv pip install "${LMCACHE_WHEEL_URL}"; \
    fi && \
    uv pip install --force-reinstall "cupy-cuda13x"

# Copy GDS scripts for Weka (kernel module loader + startup probe)
COPY docker/scripts/cuda/runtime/enable-nvidia-gds.sh /usr/local/bin/enable-nvidia-gds.sh
COPY docker/scripts/cuda/runtime/gds-startup-probe.sh /usr/local/bin/gds-startup-probe.sh
RUN chmod +x /usr/local/bin/enable-nvidia-gds.sh \
              /usr/local/bin/gds-startup-probe.sh

# Create vllm user (uid 2000, gid 0 for OpenShift anyuid SCC compatibility)
RUN useradd --uid 2000 --gid 0 -m vllm && \
    touch /home/vllm/.bashrc

# Create workspace writable by both root and vllm user (OpenShift compatible)
RUN mkdir -p /opt/vllm-source && \
    chown -R 2000:0 /opt/vllm-source && \
    chmod -R g+rwX /opt/vllm-source

# Set up models and HF cache directories (writable by group 0 for OpenShift)
ENV LLM_D_MODELS_DIR=/var/lib/llm-d/models \
    HF_HOME=/var/lib/llm-d/.hf

RUN mkdir -p "$LLM_D_MODELS_DIR" "$HF_HOME" && \
    chown -R root:0 /var/lib/llm-d && \
    chmod -R g+rwX /var/lib/llm-d && \
    find /var/lib/llm-d -type d -exec chmod g+s {} \; && \
    ln -snf /var/lib/llm-d/models /models

# Replace system python symlinks to point at the virtualenv
RUN rm -f /usr/bin/python3 /usr/bin/python3-config /usr/bin/pip && \
    ln -s /opt/vllm/bin/python3 /usr/bin/python3 && \
    ln -s /opt/vllm/bin/python3-config /usr/bin/python3-config && \
    ln -s /opt/vllm/bin/pip /usr/bin/pip

# Detect arch-specific libcuda path and add it to LD_LIBRARY_PATH
RUN ARCH=$(uname -m) && \
    if [ "${ARCH}" = "aarch64" ]; then \
        echo "/usr/lib/aarch64-linux-gnu" > /etc/ld.so.conf.d/nvidia-arch.conf; \
    else \
        echo "/usr/lib/x86_64-linux-gnu" > /etc/ld.so.conf.d/nvidia-arch.conf; \
    fi && ldconfig 2>/dev/null || true

ENV PATH="${VIRTUAL_ENV}/bin:/usr/local/nvidia/bin:${PATH}" \
    HOME=/home/vllm \
    VLLM_USAGE_SOURCE=production-docker-image \
    VLLM_WORKER_MULTIPROC_METHOD=fork \
    OUTLINES_CACHE_DIR=/tmp/outlines \
    NUMBA_CACHE_DIR=/tmp/numba \
    TRITON_CACHE_DIR=/tmp/triton \
    TORCH_NCCL_HEARTBEAT_TIMEOUT_SEC=15 \
    TORCH_NCCL_DUMP_ON_TIMEOUT=0 \
    VLLM_SKIP_P2P_CHECK=1 \
    VLLM_CACHE_ROOT=/tmp/vllm \
    UCX_MEM_MMAP_HOOK_MODE=none

USER 2000
WORKDIR /home/vllm

ENTRYPOINT ["python", "-m", "vllm.entrypoints.openai.api_server"]
